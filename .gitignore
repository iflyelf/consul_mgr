# Binaries
# 注意：项目目录本身也叫 consul_mgr，故用前导 / 锚定到根目录，
# 避免误伤同名目录（也避免 VSCode 等工具把整个项目隐藏）
/consul_mgr
/consul_mgr-*
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt

# Go workspace file
go.work

# IDEs
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
tmp/

# Config (local overrides)
etc/config.local.yaml
.env
.env.local

# Frontend
web/node_modules/
# web/dist/  # 注释掉，因为使用 embed 需要提交 dist
web/.vite/
web/.cache/

# Database
*.db
*.sqlite
*.sqlite3

# OS
Thumbs.db

# Temporary files
/tmp/
*.tmp
nohup.out
