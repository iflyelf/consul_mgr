# Consul Manager 配置（Helm Chart）
# 说明：本文件基于 values/_base.yaml.gotmpl 的默认值，通过 Helm 模板渲染为实际配置

# 关闭客户端对敏感键的泄露断言（本项目 secret 从 helmfile 环境变量注入，非明文硬编码）
assertNoLeakedSecrets: false

# ============================================
# 基础配置
# ============================================
# 固定资源名称，保证 values 模板中可静态引用 Secret 名称
fullnameOverride: consul-mgr
replicaCount: {{ .Values.replicas }}

# ============================================
# 镜像配置
# ============================================
image:
  registry: {{ .Values.imageRegistry | quote }}
  repository: {{ .Values.imageRepository | quote }}
  tag: {{ .Values.imageTag | quote }}
  pullPolicy: {{ .Values.imagePullPolicy | quote }}

# ============================================
# 服务配置
# ============================================
service:
  type: {{ .Values.serviceType | quote }}
  port: {{ .Values.servicePort }}
  # 会话亲和性（多副本场景，保证 OAuth 回调与登录落在同一实例）
  sessionAffinity: ClientIP

# ============================================
# 资源配置
# ============================================
resources:
  requests:
    cpu: {{ .Values.resourcesRequestsCpu | quote }}
    memory: {{ .Values.resourcesRequestsMemory | quote }}
  limits:
    cpu: {{ .Values.resourcesLimitsCpu | quote }}
    memory: {{ .Values.resourcesLimitsMemory | quote }}

# ============================================
# HPA 自动扩缩容配置
# ============================================
autoscaling:
  enabled: {{ .Values.hpaEnabled }}
  minReplicas: {{ .Values.hpaMinReplicas }}
  maxReplicas: {{ .Values.hpaMaxReplicas }}
  targetCPUUtilizationPercentage: {{ .Values.hpaTargetCpuUtilization }}
  targetMemoryUtilizationPercentage: {{ .Values.hpaTargetMemoryUtilization }}

# ============================================
# 节点调度配置
# ============================================
nodeSelector: {}

# 节点亲和性 + Pod 反亲和性
affinity:
  # 硬性节点亲和性：必须调度到带 nodeLabel 标签的 Linux 节点
  nodeAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      nodeSelectorTerms:
        - matchExpressions:
            - key: {{ .Values.nodeLabel | quote }}
              operator: In
              values:
                - {{ .Values.nodeLabelValue | quote }}
            - key: kubernetes.io/os
              operator: In
              values:
                - linux
  # Pod 反亲和性（硬性打散：多副本不调度到同一节点）
  # ⚠️ 硬性要求：带 nodeLabel 标签的节点数需 ≥ 副本数，否则 Pod 会 Pending
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - labelSelector:
          matchExpressions:
            - key: app.kubernetes.io/name
              operator: In
              values:
                - consul_mgr
        topologyKey: kubernetes.io/hostname

tolerations: []

# ============================================
# 健康检查配置
# ============================================
livenessProbe:
  httpGet:
    path: /health
    port: http
  initialDelaySeconds: 30
  periodSeconds: 20
  timeoutSeconds: 5
  failureThreshold: 3

readinessProbe:
  httpGet:
    path: /health
    port: http
  initialDelaySeconds: 10
  periodSeconds: 10
  timeoutSeconds: 3
  failureThreshold: 3

# ============================================
# ServiceAccount 配置
# ============================================
serviceAccount:
  create: true
  name: ""
  annotations: {}

# ============================================
# Pod 安全上下文
# ============================================
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  fsGroupChangePolicy: "OnRootMismatch"

securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
  readOnlyRootFilesystem: false
  runAsNonRoot: true
  runAsUser: 1000

# ============================================
# Pod 注解和标签
# ============================================
podAnnotations: {}

podLabels:
  environment: {{ .Values.environment | quote }}

# ============================================
# 更新策略
# ============================================
strategy:
  type: RollingUpdate
  rollingUpdate:
    maxUnavailable: 0
    maxSurge: 1

# ============================================
# 应用配置（通过环境变量注入）
# ============================================
env:
  # 服务配置
  - name: SERVER_HOST
    value: "0.0.0.0"
  - name: SERVER_PORT
    value: {{ .Values.servicePort | quote }}
  - name: SERVER_MODE
    value: "release"

  # 数据库分项配置（DATABASE_URL 未设置时生效）
  - name: DB_HOST
    value: {{ .Values.dbHost | quote }}
  - name: DB_PORT
    value: {{ .Values.dbPort | quote }}
  - name: DB_NAME
    value: {{ .Values.dbName | quote }}
  - name: DB_USER
    value: {{ .Values.dbUser | quote }}
  - name: DB_SSLMODE
    value: {{ .Values.dbSslMode | quote }}
  - name: DB_MAX_OPEN_CONNS
    value: {{ .Values.dbMaxOpenConns | quote }}
  - name: DB_MAX_IDLE_CONNS
    value: {{ .Values.dbMaxIdleConns | quote }}
  - name: DB_CONN_MAX_LIFETIME
    value: {{ .Values.dbConnMaxLifetime | quote }}
  {{- if .Values.databaseUrl }}
  - name: DATABASE_URL
    value: {{ .Values.databaseUrl | quote }}
  {{- end }}

  # Redis 配置
  - name: REDIS_ENABLED
    value: {{ .Values.redisEnabled | quote }}
  - name: REDIS_HOST
    value: {{ .Values.redisHost | quote }}
  - name: REDIS_PORT
    value: {{ .Values.redisPort | quote }}
  - name: REDIS_DB
    value: {{ .Values.redisDb | quote }}
  - name: REDIS_CACHE_TTL
    value: {{ .Values.redisCacheTtl | quote }}

  # JWT 配置
  - name: JWT_ACCESS_EXPIRE
    value: {{ .Values.jwtAccessExpire | quote }}
  - name: JWT_REFRESH_EXPIRE
    value: {{ .Values.jwtRefreshExpire | quote }}
  - name: JWT_ISSUER
    value: {{ .Values.jwtIssuer | quote }}

  # 管理员配置
  - name: ADMIN_USERNAME
    value: {{ .Values.adminUsername | quote }}
  - name: ADMIN_EMAIL
    value: {{ .Values.adminEmail | quote }}

  # 默认 Consul 配置
  {{- if .Values.consulAddress }}
  - name: CONSUL_ADDRESS
    value: {{ .Values.consulAddress | quote }}
  {{- end }}
  - name: CONSUL_DATACENTER
    value: {{ .Values.consulDatacenter | quote }}
  - name: CONSUL_TIMEOUT
    value: {{ .Values.consulTimeout | quote }}
  - name: CONSUL_MAX_CONCURRENCY
    value: {{ .Values.consulMaxConcurrency | quote }}

  # 认证配置（复用外部 FlyIAM 提供的 Casdoor）
  - name: CASDOOR_ENDPOINT
    value: {{ .Values.casdoorEndpoint | quote }}
  {{- if .Values.casdoorPublicEndpoint }}
  - name: CASDOOR_PUBLIC_ENDPOINT
    value: {{ .Values.casdoorPublicEndpoint | quote }}
  {{- end }}
  - name: CASDOOR_CERTIFICATE
    value: {{ .Values.casdoorCertificate | quote }}
  - name: CASDOOR_ORGANIZATION
    value: {{ .Values.casdoorOrganization | quote }}
  - name: CASDOOR_APPLICATION
    value: {{ .Values.casdoorApplication | quote }}
  - name: CASDOOR_DEFAULT_PASSWORD
    value: {{ .Values.casdoorDefaultPassword | quote }}

  # 权限配置
  - name: PERMISSION_ENABLE_SERVICE_GROUP_AUTH
    value: {{ .Values.permissionEnableServiceGroupAuth | quote }}
  - name: PERMISSION_DEFAULT
    value: {{ .Values.permissionDefault | quote }}

  # 审计日志配置
  - name: AUDIT_ENABLED
    value: {{ .Values.auditEnabled | quote }}
  - name: AUDIT_RETENTION_DAYS
    value: {{ .Values.auditRetentionDays | quote }}

  # 日志配置
  - name: LOG_LEVEL
    value: {{ .Values.logLevel | quote }}
  - name: LOG_FORMAT
    value: {{ .Values.logFormat | quote }}

  # FlyIAM 服务对接（令牌经 Secret 注入）
  {{- if .Values.flyiamApiEndpoint }}
  - name: CONSUL_MGR_FLYIAM_API_ENDPOINT
    value: {{ .Values.flyiamApiEndpoint | quote }}
  {{- end }}
  - name: CONSUL_MGR_FLYIAM_SYNC_ENABLED
    value: {{ .Values.flyiamSyncEnabled | quote }}
  - name: CONSUL_MGR_FLYIAM_SYNC_ON_STARTUP
    value: {{ .Values.flyiamSyncOnStartup | quote }}
  - name: CONSUL_MGR_FLYIAM_SYNC_INTERVAL
    value: {{ .Values.flyiamSyncInterval | quote }}

  # 安全与跨域配置
  - name: AUTH_COOKIE_SAMESITE
    value: {{ .Values.authCookieSameSite | quote }}
  - name: AUTH_COOKIE_SECURE
    value: {{ .Values.authCookieSecure | quote }}
  {{- if .Values.authCookieDomain }}
  - name: AUTH_COOKIE_DOMAIN
    value: {{ .Values.authCookieDomain | quote }}
  {{- end }}
  {{- if .Values.corsAllowedOrigins }}
  - name: CORS_ALLOWED_ORIGINS
    value: {{ .Values.corsAllowedOrigins | quote }}
  {{- end }}

# ============================================
# 敏感信息配置（从 Secret 注入）
# ============================================
envFrom:
  {{- if .Values.existingSecret }}
  - secretRef:
      name: {{ .Values.existingSecret | quote }}
  {{- else }}
  - secretRef:
      name: consul-mgr-secret
  {{- end }}

# ============================================
# 引用已存在的 Secret
# ============================================
existingSecret: {{ .Values.existingSecret | quote }}

# Secret 数据（如果不使用 existingSecret）
secret:
  DB_PASSWORD: {{ .Values.dbPassword | quote }}
  REDIS_PASSWORD: {{ .Values.redisPassword | quote }}
  JWT_SECRET: {{ .Values.jwtSecret | quote }}
  ADMIN_PASSWORD: {{ .Values.adminPassword | quote }}
  CASDOOR_CLIENT_ID: {{ .Values.casdoorClientId | quote }}
  CASDOOR_CLIENT_SECRET: {{ .Values.casdoorClientSecret | quote }}
  {{- if .Values.consulToken }}
  CONSUL_TOKEN: {{ .Values.consulToken | quote }}
  {{- end }}
  {{- if .Values.flyiamServiceToken }}
  # 服务间调用凭证（同步 FlyIAM 用户字段；经 Secret 注入，不落 env 明文）
  CONSUL_MGR_FLYIAM_SERVICE_TOKEN: {{ .Values.flyiamServiceToken | quote }}
  {{- end }}

# ============================================
# Casdoor 集群内引用（ExternalName Service，casdoorInCluster=true 时使用）
# 把 FlyIAM 命名空间中的 Casdoor Service 映射为本命名空间别名，
# 从而可继续使用短名 http://<name>:<port> 访问。
# ============================================
casdoorExternalService:
  enabled: {{ .Values.casdoorExternalServiceEnabled }}
  name: {{ .Values.casdoorExternalServiceName | quote }}
  namespace: {{ .Values.casdoorNamespace | quote }}
  serviceName: {{ .Values.casdoorServiceName | quote }}
  port: {{ .Values.casdoorServicePort }}

# ============================================
# NetworkPolicy 网络策略
# ============================================
networkPolicy:
  enabled: {{ .Values.networkPolicyEnabled }}
  # 入站
  allowAllIngress: {{ .Values.networkPolicyAllowAllIngress }}
  ingressNamespaces: {{ .Values.networkPolicyIngressNamespaces | quote }}
  # 出站
  allowAllEgress: {{ .Values.networkPolicyAllowAllEgress }}
  dbCidrs: {{ .Values.networkPolicyDbCidrs | quote }}
  consulCidrs: {{ .Values.networkPolicyConsulCidrs | quote }}
  dbPort: {{ .Values.dbPort }}
  redisEnabled: {{ .Values.redisEnabled }}
  redisPort: {{ .Values.redisPort }}
  # Casdoor 放行规则
  casdoor:
    # false=外置域名方式（CIDR/端口放行）；true=集群内方式（命名空间+Pod 标签放行）
    inCluster: {{ .Values.casdoorInCluster }}
    # 外置域名方式：域名对应 CIDR（留空则按端口放行任意目标）
    externalCidrs: {{ .Values.networkPolicyCasdoorCidrs | quote }}
    # 外置域名方式：端口列表（默认 443,80 标准端口）
    externalPorts: {{ .Values.networkPolicyCasdoorPorts | quote }}
    # 集群内方式：命名空间 + Pod 标签 + 端口
    namespace: {{ .Values.casdoorNamespace | quote }}
    podLabelKey: {{ .Values.casdoorPodLabelKey | quote }}
    podLabelValue: {{ .Values.casdoorPodLabelValue | quote }}
    port: {{ .Values.casdoorServicePort }}
  # 本应用端口（入站端口白名单）
  appPort: {{ .Values.servicePort }}
