# ============================================
# 公共环境变量（所有环境共享的默认值）
# ============================================
# 说明：helmfile 各环境（default/dev/staging/prod）不会自动继承彼此的值，
# 因此将所有环境共享的配置集中在本文件，由每个环境通过 values 引用后再叠加各自覆盖项。
# 修改公共默认值只需编辑本文件；环境差异（命名空间、副本数等）在 helmfile.yaml 的
# environments.<env>.values 中覆盖。
#
# ★ 全量环境变量覆盖：本文件所有配置项均支持通过环境变量覆盖，
#   格式统一为 {{`{{ env "ENV_NAME" | default "默认值" }}`}}。
#   未设置环境变量时使用默认值，无需修改文件即可通过 export 覆盖任意配置。

# ==================== 基础配置 ====================
# 命名空间
namespace: '{{ env "CONSUL_MGR_NAMESPACE" | default "consul-mgr" }}'
# 环境标识（用于资源标签）
environment: '{{ env "CONSUL_MGR_ENVIRONMENT" | default "production" }}'

# ==================== 镜像配置 ====================
# 镜像仓库地址
imageRegistry: '{{ env "CONSUL_MGR_IMAGE_REGISTRY" | default "swr.cn-east-3.myhuaweicloud.com" }}'
# 镜像仓库路径
imageRepository: '{{ env "CONSUL_MGR_IMAGE_REPOSITORY" | default "iflyelf/consul-mgr" }}'
# 镜像标签
imageTag: '{{ env "CONSUL_MGR_IMAGE_TAG" | default "latest" }}'
# 镜像拉取策略
imagePullPolicy: '{{ env "CONSUL_MGR_IMAGE_PULL_POLICY" | default "Always" }}'

# ==================== 服务端口配置 ====================
# 服务端口
servicePort: {{ env "CONSUL_MGR_SERVICE_PORT" | default "8080" }}
# 服务类型（ClusterIP / NodePort / LoadBalancer）
serviceType: '{{ env "CONSUL_MGR_SERVICE_TYPE" | default "ClusterIP" }}'

# ==================== 副本配置 ====================
# 副本数（支持多副本高可用）
replicas: {{ env "CONSUL_MGR_REPLICAS" | default "2" }}

# ==================== 数据库配置（PostgreSQL - 外置）====================
# 数据库地址
dbHost: '{{ env "CONSUL_MGR_DB_HOST" | default "postgres.default.svc.cluster.local" }}'
# 数据库端口
dbPort: {{ env "CONSUL_MGR_DB_PORT" | default "5432" }}
# 数据库名称
dbName: '{{ env "CONSUL_MGR_DB_NAME" | default "consul_mgr" }}'
# 数据库用户名
dbUser: '{{ env "CONSUL_MGR_DB_USER" | default "consul_mgr" }}'
# 数据库密码（优先从环境变量读取，生产环境建议使用 existingSecret）
dbPassword: '{{ env "CONSUL_MGR_DB_PASSWORD" | default "ysyh!9Sky" }}'
# 数据库 SSL 模式
dbSslMode: '{{ env "CONSUL_MGR_DB_SSL_MODE" | default "disable" }}'
# 完整连接串（设置后优先于上方分项）
databaseUrl: '{{ env "CONSUL_MGR_DATABASE_URL" | default "" }}'
# 数据库连接池配置
dbMaxOpenConns: {{ env "CONSUL_MGR_DB_MAX_OPEN_CONNS" | default "100" }}
dbMaxIdleConns: {{ env "CONSUL_MGR_DB_MAX_IDLE_CONNS" | default "10" }}
dbConnMaxLifetime: {{ env "CONSUL_MGR_DB_CONN_MAX_LIFETIME" | default "3600" }}

# ==================== Redis 配置（外置）====================
# 是否启用 Redis 缓存（不可用时自动降级）
redisEnabled: {{ env "CONSUL_MGR_REDIS_ENABLED" | default "true" }}
# Redis 地址
redisHost: '{{ env "CONSUL_MGR_REDIS_HOST" | default "redis.default.svc.cluster.local" }}'
# Redis 端口
redisPort: {{ env "CONSUL_MGR_REDIS_PORT" | default "6379" }}
# Redis 密码
redisPassword: '{{ env "CONSUL_MGR_REDIS_PASSWORD" | default "ysyh!9Sky" }}'
# Redis 数据库编号
redisDb: {{ env "CONSUL_MGR_REDIS_DB" | default "0" }}
# Redis 缓存 TTL（秒）
redisCacheTtl: {{ env "CONSUL_MGR_REDIS_CACHE_TTL" | default "300" }}

# ==================== JWT 配置 ====================
# JWT 密钥（必填，建议 32 位以上随机字符串，生产环境必须使用 existingSecret）
jwtSecret: '{{ env "CONSUL_MGR_JWT_SECRET" | default "ysyh!9SkyFlyIAMSecretKey2024xxxxxxxx" }}'
# 说明：JWT 过期时间/签发者、管理员用户名/邮箱、Consul 默认、权限、审计、日志、
# 安全/跨域等均可经「系统设置」页面配置（存数据库），不再由 Chart 注入。

# ==================== 管理员密码 ====================
# 管理员密码（生产环境必须使用 existingSecret）
adminPassword: '{{ env "CONSUL_MGR_ADMIN_PASSWORD" | default "ysyh!9Sky" }}'

# ==================== 认证配置（复用外部 FlyIAM 提供的 Casdoor）====================
# 默认：外置域名方式（经域名对外暴露）
#   后端通过外置域名访问 Casdoor，标准端口无需显式书写：
#     https://casdoor.example.com  → 443
#     http://casdoor.example.com   → 80
casdoorEndpoint: '{{ env "CONSUL_MGR_CASDOOR_ENDPOINT" | default "" }}'
# Casdoor 公开地址（浏览器访问；留空则回退为 casdoorEndpoint）
casdoorPublicEndpoint: '{{ env "CONSUL_MGR_CASDOOR_PUBLIC_ENDPOINT" | default "" }}'
# Casdoor 是否位于集群内（走 Service/DNS）
#   false（默认）：外置域名方式，NetworkPolicy 按域名/CIDR 放行出站
#   true：集群内方式，NetworkPolicy 使用 namespaceSelector + podSelector 精确放行
casdoorInCluster: {{ env "CONSUL_MGR_CASDOOR_IN_CLUSTER" | default "false" }}
# 应用凭据（从 FlyIAM 获取）
casdoorClientId: '{{ env "CONSUL_MGR_CASDOOR_CLIENT_ID" | default "" }}'
casdoorClientSecret: '{{ env "CONSUL_MGR_CASDOOR_CLIENT_SECRET" | default "" }}'
# 应用证书名（Casdoor 内置证书）
casdoorCertificate: '{{ env "CONSUL_MGR_CASDOOR_CERTIFICATE" | default "cert-built-in" }}'
# 组织名称（与 FlyIAM 保持一致）
casdoorOrganization: '{{ env "CONSUL_MGR_CASDOOR_ORGANIZATION" | default "flyiam" }}'
# 应用名称（与 FlyIAM 保持一致）
casdoorApplication: '{{ env "CONSUL_MGR_CASDOOR_APPLICATION" | default "flyiam" }}'
# 新增用户时的默认密码
casdoorDefaultPassword: '{{ env "CONSUL_MGR_CASDOOR_DEFAULT_PASSWORD" | default "ysyh!9Sky" }}'

# ==================== FlyIAM 服务对接 ====================
# 用于：① 同步用户字段定义；② 自动获取 Casdoor 应用凭据（免手工填写 ClientID/Secret）。
# 留空则不启用；两种能力均需与 FlyIAM 的 SERVICE_TOKEN 或页面 API 令牌一致。
flyiamApiEndpoint: '{{ env "CONSUL_MGR_FLYIAM_API_ENDPOINT" | default "" }}'
flyiamServiceToken: '{{ env "CONSUL_MGR_FLYIAM_SERVICE_TOKEN" | default "" }}'

# ==================== Casdoor 集群内引用（可选，casdoorInCluster=true 时使用）====================
# FlyIAM（内置 Casdoor）所在命名空间
casdoorNamespace: '{{ env "CONSUL_MGR_CASDOOR_NAMESPACE" | default "flyiam" }}'
# FlyIAM 中 Casdoor Service 的名称与端口（集群内方式；外置域名方式不使用）
casdoorServiceName: '{{ env "CONSUL_MGR_CASDOOR_SERVICE_NAME" | default "casdoor" }}'
casdoorServicePort: {{ env "CONSUL_MGR_CASDOOR_SERVICE_PORT" | default "8000" }}
# Casdoor Pod 标签（casdoorInCluster=true 时用于 NetworkPolicy 精确放行；与 FlyIAM Chart 的 selector 一致）
casdoorPodLabelKey: '{{ env "CONSUL_MGR_CASDOOR_POD_LABEL_KEY" | default "app.kubernetes.io/component" }}'
casdoorPodLabelValue: '{{ env "CONSUL_MGR_CASDOOR_POD_LABEL_VALUE" | default "casdoor" }}'
# 是否在本命名空间创建 ExternalName Service（把集群内 Casdoor 映射为别名，便于使用短名）
#   默认关闭（默认外置域名方式，无需集群内别名）
casdoorExternalServiceEnabled: {{ env "CONSUL_MGR_CASDOOR_EXTERNAL_SERVICE_ENABLED" | default "false" }}
# 别名 Service 名称（默认与远端同名，指向 casdoor.<namespace>.svc.cluster.local）
casdoorExternalServiceName: '{{ env "CONSUL_MGR_CASDOOR_EXTERNAL_SERVICE_NAME" | default "casdoor" }}'

# ==================== NetworkPolicy 网络策略 ====================
# 是否创建 NetworkPolicy（需集群 CNI 支持，如 Calico / Cilium；不支持的 CNI 会忽略）
networkPolicyEnabled: {{ env "CONSUL_MGR_NETWORK_POLICY_ENABLED" | default "true" }}
# 入站：允许访问本应用端口的所有来源（默认放开；可改为指定命名空间）
networkPolicyAllowAllIngress: {{ env "CONSUL_MGR_NETWORK_POLICY_ALLOW_ALL_INGRESS" | default "true" }}
# 入站：当 allowAllIngress=false 时，允许的入口命名空间列表（逗号分隔，留空表示仅当前命名空间）
networkPolicyIngressNamespaces: '{{ env "CONSUL_MGR_NETWORK_POLICY_INGRESS_NAMESPACES" | default "" }}'
# 出站：数据库/Redis 目标 CIDR 列表（逗号分隔；留空表示不限目标，仅按端口放行）
#   外置数据库/Redis 在集群外时，建议填写其网段以收紧出站
networkPolicyDbCidrs: '{{ env "CONSUL_MGR_NETWORK_POLICY_DB_CIDRS" | default "" }}'
# 出站：Consul 集群网段（逗号分隔，放行全部端口）
#   ⚠️ Consul 集群地址/端口在运行时按「服务组」配置，无法预先穷举；
#      留空时出站对 Consul 不限制（等价放开出站），填写后可真正收紧。
networkPolicyConsulCidrs: '{{ env "CONSUL_MGR_NETWORK_POLICY_CONSUL_CIDRS" | default "" }}'
# 出站：外置 Casdoor 域名对应的 CIDR 列表（逗号分隔；casdoorInCluster=false 时生效）
#   留空：按端口放行到任意目标（外置域名通常解析为公网 IP，无法预先穷举）
#   填写：仅放行这些网段，推荐在生产环境填写
networkPolicyCasdoorCidrs: '{{ env "CONSUL_MGR_NETWORK_POLICY_CASDOOR_CIDRS" | default "" }}'
# 出站：外置 Casdoor 端口列表（逗号分隔；casdoorInCluster=false 时生效）
#   外置域名默认走标准端口 443(https) / 80(http)
networkPolicyCasdoorPorts: '{{ env "CONSUL_MGR_NETWORK_POLICY_CASDOOR_PORTS" | default "443,80" }}'
# 出站：是否放行全部出站（调试用；生产建议 false 并依赖下方精确规则）
networkPolicyAllowAllEgress: {{ env "CONSUL_MGR_NETWORK_POLICY_ALLOW_ALL_EGRESS" | default "false" }}

# ==================== 节点调度配置 ====================
# 节点标签（用于硬性节点亲和性，必须调度到带该标签的 Linux 节点）
nodeLabel: '{{ env "CONSUL_MGR_NODE_LABEL" | default "consul_mgr" }}'
nodeLabelValue: '{{ env "CONSUL_MGR_NODE_LABEL_VALUE" | default "true" }}'

# ==================== 资源限制配置 ====================
resourcesRequestsCpu: '{{ env "CONSUL_MGR_RES_REQ_CPU" | default "100m" }}'
resourcesRequestsMemory: '{{ env "CONSUL_MGR_RES_REQ_MEM" | default "128Mi" }}'
resourcesLimitsCpu: '{{ env "CONSUL_MGR_RES_LIM_CPU" | default "1" }}'
resourcesLimitsMemory: '{{ env "CONSUL_MGR_RES_LIM_MEM" | default "512Mi" }}'

# ==================== HPA 自动扩缩容配置 ====================
hpaEnabled: {{ env "CONSUL_MGR_HPA_ENABLED" | default "false" }}
hpaMinReplicas: {{ env "CONSUL_MGR_HPA_MIN_REPLICAS" | default "2" }}
hpaMaxReplicas: {{ env "CONSUL_MGR_HPA_MAX_REPLICAS" | default "10" }}
hpaTargetCpuUtilization: {{ env "CONSUL_MGR_HPA_TARGET_CPU" | default "80" }}
hpaTargetMemoryUtilization: {{ env "CONSUL_MGR_HPA_TARGET_MEMORY" | default "80" }}

# ==================== 引用已存在的 Secret ====================
# 如果设置，将从该 Secret 读取敏感信息，优先级高于上面的明文配置
# Secret 必须包含以下 key:
#   - DB_PASSWORD          # 数据库密码
#   - REDIS_PASSWORD       # Redis 密码（可选）
#   - JWT_SECRET           # JWT 密钥
#   - ADMIN_PASSWORD       # 管理员密码
#   - CASDOOR_CLIENT_ID    # Casdoor Client ID
#   - CASDOOR_CLIENT_SECRET  # Casdoor Client Secret
#   - CONSUL_TOKEN         # 默认 Consul Token（可选）
existingSecret: '{{ env "CONSUL_MGR_EXISTING_SECRET" | default "" }}'
